# Public site URL (no secret)
NEXT_PUBLIC_SITE_URL=https://example.com

# Local Next.js reads production D1 over the Cloudflare API and cannot write it.
# CLOUDFLARE_ACCOUNT_ID is required. The database id below is the existing CMS database.
# Do not set CMS_RUNTIME locally. The Worker sets CMS_RUNTIME=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=a7b9675c-46b4-481e-a7ce-447985f5b63b

# Google Analytics 4 Measurement ID (loaded only after cookie Accept)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R1EWB8T76C

# Admin auth — set the same values in Cloudflare Pages → Settings → Environment variables / Secrets
# Requirements enforced by the app:
#   ADMIN_PASSWORD        ≥ 12 characters, not a common weak password, ≠ ADMIN_SESSION_SECRET
#   ADMIN_SESSION_SECRET  ≥ 32 characters of random data, ≠ ADMIN_PASSWORD
#
# Generate a strong session secret:
#   openssl rand -base64 48
#
# Changing ADMIN_PASSWORD or ADMIN_SESSION_SECRET immediately invalidates all admin sessions.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
